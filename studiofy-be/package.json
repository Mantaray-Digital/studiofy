    "i": "^0.3.7",
    "ioredis": "^5.8.2",
    "mongodb": "^7.0.0",
    "mongoose": "^8.20.1",
    "nanoid": "^5.1.6",
    "npm": "^11.6.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
